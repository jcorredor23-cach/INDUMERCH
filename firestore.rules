/**
 * @file Firestore Security Rules for Steel Foundry App
 *
 * @description This ruleset enforces a strict user-ownership model for all data within the application.
 * All data is nested under `/artifacts/{appId}/users/{userId}`, ensuring that only the authenticated user can
 * access their own data. This approach avoids the need for complex data validation and ensures strong data segregation.
 *
 * Data Structure:
 * - /artifacts/{appId}/users/{userId}/materia_prima_fundicion/{rawMaterialId}: Raw material data owned by the user.
 * - /artifacts/{appId}/users/{userId}/clients/{clientId}: Client data owned by the user.
 * - /artifacts/{appId}/users/{userId}/ordenes_produccion_fundicion/{productionOrderId}: Production order data owned by the user.
 * - /artifacts/{appId}/users/{userId}/incidents/{incidentId}: Incident data owned by the user.
 *
 * Key Security Decisions:
 * - User listing is implicitly denied as there are no top-level user documents.
 * - All data access is predicated on the user being authenticated and attempting to access
 *   data under their own user ID.
 * - The ruleset prioritizes simplicity and security by strictly enforcing ownership. Data validation
 *   is kept to a minimum to allow for rapid prototyping and iteration.
 *
 * Denormalization for Authorization:
 * - The data structure inherently denormalizes ownership by nesting all relevant data under the user's path.
 *   This allows for efficient, path-based security rules without the need for additional `get()` calls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by an authenticated user.
     * @returns {boolean} True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID, and that the resource exists.
     * @param {string} userId The user ID to compare against the authenticated user's ID.
     * @returns {boolean} True if the user is the owner and the resource exists, false otherwise.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Rules for raw material documents.
     * @path /artifacts/{appId}/users/{userId}/materia_prima_fundicion/{rawMaterialId}
     * @allow (create) User 'user_abc' can create a new raw material document under their user ID.
     * @allow (get) User 'user_abc' can read their own raw material document.
     * @allow (list) User 'user_abc' can list raw material documents under their user ID.
     * @allow (update) User 'user_abc' can update their own existing raw material document.
     * @allow (delete) User 'user_abc' can delete their own existing raw material document.
     * @deny (create) User 'user_xyz' cannot create a raw material document under 'user_abc's user ID.
     * @deny (update) User 'user_xyz' cannot update a raw material document under 'user_abc's user ID.
     * @deny (delete) User 'user_xyz' cannot delete a raw material document under 'user_abc's user ID.
     * @principle Enforces document ownership for all operations.
     */
    match /artifacts/{appId}/users/{userId}/materia_prima_fundicion/{rawMaterialId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for client documents.
     * @path /artifacts/{appId}/users/{userId}/clients/{clientId}
     * @allow (create) User 'user_abc' can create a new client document under their user ID.
     * @allow (get) User 'user_abc' can read their own client document.
     * @allow (list) User 'user_abc' can list client documents under their user ID.
     * @allow (update) User 'user_abc' can update their own existing client document.
     * @allow (delete) User 'user_abc' can delete their own existing client document.
     * @deny (create) User 'user_xyz' cannot create a client document under 'user_abc's user ID.
     * @deny (update) User 'user_xyz' cannot update a client document under 'user_abc's user ID.
     * @deny (delete) User 'user_xyz' cannot delete a client document under 'user_abc's user ID.
     * @principle Enforces document ownership for all operations.
     */
    match /artifacts/{appId}/users/{userId}/clients/{clientId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for production order documents.
     * @path /artifacts/{appId}/users/{userId}/ordenes_produccion_fundicion/{productionOrderId}
     * @allow (create) User 'user_abc' can create a new production order document under their user ID.
     * @allow (get) User 'user_abc' can read their own production order document.
     * @allow (list) User 'user_abc' can list production order documents under their user ID.
     * @allow (update) User 'user_abc' can update their own existing production order document.
     * @allow (delete) User 'user_abc' can delete their own existing production order document.
     * @deny (create) User 'user_xyz' cannot create a production order document under 'user_abc's user ID.
     * @deny (update) User 'user_xyz' cannot update a production order document under 'user_abc's user ID.
     * @deny (delete) User 'user_xyz' cannot delete a production order document under 'user_abc's user ID.
     * @principle Enforces document ownership for all operations.
     */
    match /artifacts/{appId}/users/{userId}/ordenes_produccion_fundicion/{productionOrderId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Rules for incident documents.
     * @path /artifacts/{appId}/users/{userId}/incidents/{incidentId}
     * @allow (create) User 'user_abc' can create a new incident document under their user ID.
     * @allow (get) User 'user_abc' can read their own incident document.
     * @allow (list) User 'user_abc' can list incident documents under their user ID.
     * @allow (update) User 'user_abc' can update their own existing incident document.
     * @allow (delete) User 'user_abc' can delete their own existing incident document.
     * @deny (create) User 'user_xyz' cannot create an incident document under 'user_abc's user ID.
     * @deny (update) User 'user_xyz' cannot update an incident document under 'user_abc's user ID.
     * @deny (delete) User 'user_xyz' cannot delete an incident document under 'user_abc's user ID.
     * @principle Enforces document ownership for all operations.
     */
    match /artifacts/{appId}/users/{userId}/incidents/{incidentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

     /**
     * @description Rules for provider documents.
     * @path /artifacts/{appId}/users/{userId}/providers/{providerId}
     * @principle Enforces document ownership for all operations.
     */
    match /artifacts/{appId}/users/{userId}/providers/{providerId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}
